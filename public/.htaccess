# IMR Services – Apache config for HostPresto (cPanel / LiteSpeed-compatible)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS and bare domain
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://imrservices.net%{REQUEST_URI} [L,R=301]

# Old site URLs → new pages (keep existing rankings)
RewriteRule ^index\.html?$ / [L,R=301,NC]
RewriteRule ^pat-testing\.html?$ /pat-testing/ [L,R=301,NC]
RewriteRule ^about-us\.html?$ /about/ [L,R=301,NC]
RewriteRule ^services\.html?$ /pat-testing/ [L,R=301,NC]
RewriteRule ^contact-us\.html?$ /contact/ [L,R=301,NC]

# Trailing slash for directory pages (not the Node API under /api/)
RewriteCond %{REQUEST_URI} !^/api(/|$)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-z0-9]{2,5}|/)$ [NC]
RewriteRule ^(.*)$ /$1/ [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
