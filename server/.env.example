# Environment variables for the IMR quote API (server/).
#
# Production: enter these in cPanel → Setup Node.js App → imr-api → Environment variables.
#             Never put real values in this file or commit them.
# Local:      copy to server/.env (git-ignored), fill in, then `npm run api`.

# ── Database (required) ─────────────────────────────────────────────
# cPanel prefixes the database and user with your cPanel username.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_imr
DB_USER=cpaneluser_imr
DB_PASS=

# ── Secrets (required) ──────────────────────────────────────────────
# Two different long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT=
SESSION_SECRET=

# Enquiries inbox (/api/admin/) password hash. Generate with:
#   npm --prefix server run hash-password
ADMIN_HASH=

# ── Email (optional) ────────────────────────────────────────────────
# Where enquiry emails go. Defaults to the email in src/data/site.json.
NOTIFY_TO=

# sendmail = the host's mail system (default, no password needed)
# smtp     = send through a mailbox (fill in SMTP_* below)
# log      = print emails to the console instead of sending (local testing)
MAIL_TRANSPORT=sendmail
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Local only ──────────────────────────────────────────────────────
# Set to 1 to allow the inbox login cookie over plain http://localhost.
INSECURE_COOKIES=
# Port for `npm run api` (cPanel sets its own). Default 8787.
PORT=
