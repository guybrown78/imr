---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../lib/site';
const r = site.reviews;
---
<Base title="Reviews | IMR Services PAT Testing Teesside" description="What Teesside businesses say about IMR Services PAT testing.">
  <PageHead label="Reviews" title="What our customers say." lede={r.googleCount ? `Rated ${r.googleRating} out of 5 from ${r.googleCount} Google reviews.` : 'Real feedback from businesses we test for.'} crumbs={[{ name: 'Reviews' }]}>
    {r.googleUrl && <a class="btn" style="margin-top:1rem" href={r.googleUrl} rel="noopener">Read us on Google</a>}
  </PageHead>
  <section class="section section--paper">
    <div class="wrap rv">
      {site.testimonials.map((t) => (
        <figure><blockquote><p>“{t.quote}”</p></blockquote><figcaption class="mono">{t.who} · {t.where}</figcaption></figure>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .rv { display: grid; gap: 1rem; }
  figure { margin: 0; padding: 1.75rem; border-left: 4px solid var(--forest); background: var(--mist); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
  blockquote { margin: 0; }
  blockquote p { font-size: var(--step-2); font-weight: 650; letter-spacing: -0.02em; line-height: 1.25; }
  figcaption { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--forest); }
  @media (min-width: 860px) { .rv { grid-template-columns: 1fr 1fr; } }
</style>
