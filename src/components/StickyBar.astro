---
import Icon from './Icon.astro';
import { phone, waLink } from '../lib/site';
---
<div class="sbar on-dark" aria-label="Quick contact">
  <a href={phone.tel}><Icon name="phone" /><span>Call</span></a>
  <a href={waLink('Hi IMR, I’d like a price for PAT testing.')} rel="noopener"><Icon name="whatsapp" /><span>WhatsApp</span></a>
  <a href="/quote/" class="sbar__go"><span>Instant price</span><Icon name="arrow" /></a>
</div>
<style>
  .sbar { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 0.85fr 1.15fr 1.4fr; gap: 1px; background: rgba(207, 247, 224, 0.15); padding-bottom: env(safe-area-inset-bottom); }
  .sbar a { display: flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 58px; padding-inline: 0.4rem; background: var(--ink); color: #fff; font-weight: 650; text-decoration: none; font-size: 0.98rem; }
  .sbar a :global(svg) { width: 20px; color: var(--signal); }
  .sbar .sbar__go { background: var(--signal); color: var(--ink); }
  .sbar .sbar__go :global(svg) { color: var(--ink); }
  @media (min-width: 1080px) { .sbar { display: none; } }
  :global(body) { padding-bottom: calc(58px + env(safe-area-inset-bottom)); }
  @media (min-width: 1080px) { :global(body) { padding-bottom: 0; } }
</style>
