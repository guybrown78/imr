---
interface Props { items: { q: string; a: string }[]; id?: string }
const { items, id } = Astro.props;
---
<div class="faq" id={id}>
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1.5px solid var(--ink); }
  details { border-bottom: 1px solid var(--line-strong); }
  summary { list-style: none; display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1.15rem 0; cursor: pointer; font-weight: 650; font-size: var(--step-1); letter-spacing: -0.01em; line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  summary:hover span { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  i { flex: none; position: relative; width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid var(--forest); }
  i::before, i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.75px; margin: -0.9px 0 0 -5.5px; background: var(--forest); transition: transform 0.2s; }
  i::after { transform: rotate(90deg); }
  details[open] i { background: var(--forest); }
  details[open] i::before, details[open] i::after { background: #fff; }
  details[open] i::after { transform: rotate(0); }
  p { margin: 0 0 1.25rem; max-width: 64ch; color: var(--text-muted); }
</style>
